<ci:ComponentBase x:Class="DutyAgentBridge.Controls.DutyComponentSettingsControl"
                  x:TypeArguments="settings:DutyComponentSettings"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:settings="clr-namespace:DutyAgentBridge.Models"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  x:CompileBindings="False"
                  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
  <StackPanel Spacing="8">
    <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE8D4;}"
                         Header="字体大小"
                         Description="值日文本的显示字号。">
      <fa:SettingsExpander.Footer>
        <NumericUpDown Minimum="8" Maximum="72" Increment="1" Width="130"
                       Value="{Binding Settings.FontSize, Mode=TwoWay}"/>
      </fa:SettingsExpander.Footer>
    </fa:SettingsExpander>

    <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE790;}"
                         Header="字体颜色"
                         Description="留空跟随 ClassIsland 主题；可填 #RRGGBB 或颜色名。">
      <fa:SettingsExpander.Footer>
        <TextBox MinWidth="128" Watermark="跟随主题"
                 Text="{Binding Settings.FontColor, Mode=TwoWay}"/>
      </fa:SettingsExpander.Footer>
    </fa:SettingsExpander>

    <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE751;}"
                         Header="换行方式"
                         Description="不换行 / 每个区域一行 / 按人数对半拆成两行。">
      <fa:SettingsExpander.Footer>
        <ComboBox MinWidth="170"
                  SelectedIndex="{Binding Settings.WrapModeIndex, Mode=TwoWay}">
          <ComboBoxItem Content="不换行"/>
          <ComboBoxItem Content="按区域换行"/>
          <ComboBoxItem Content="对半拆分（两行）"/>
        </ComboBox>
      </fa:SettingsExpander.Footer>
    </fa:SettingsExpander>
  </StackPanel>
</ci:ComponentBase>
