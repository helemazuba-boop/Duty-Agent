<ci:SettingsPageBase x:Class="DutyAgentBridge.Views.DutyBridgeSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:views="clr-namespace:DutyAgentBridge.Views"
                     x:CompileBindings="False"
                     mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600">

  <ScrollViewer>
    <StackPanel Margin="12" Spacing="8" MaxWidth="900" HorizontalAlignment="Stretch">

      <fa:SettingsExpander Header="连接状态"
                           Description="与独立 Duty-Agent 客户端（后端宿主）的桥接连接。"
                           IconSource="{ci:FluentIconSource &#xE7F4;}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="StatusIndicator" Text="○ 未连接" FontSize="15"/>
          <TextBlock x:Name="ConnectionDetails" Text="" FontSize="12" Opacity="0.7" IsVisible="False"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ReconnectButton" Content="重新连接" Click="OnReconnectClick"/>
            <Button Content="打开状态目录" Click="OnOpenStandaloneClick"/>
          </StackPanel>
        </StackPanel>
      </fa:SettingsExpander>

      <fa:SettingsExpander Header="自动连接"
                           Description="ClassIsland 启动后自动连接独立 Duty-Agent 软件；关闭后仍可在上方手动重连。"
                           IconSource="{ci:FluentIconSource &#xE895;}">
        <fa:SettingsExpander.Footer>
          <ToggleSwitch IsChecked="{Binding Settings.AutoConnect, Mode=TwoWay}"/>
        </fa:SettingsExpander.Footer>
      </fa:SettingsExpander>

      <fa:SettingsExpander Header="连接参数"
                           Description="连接超时与健康检查节奏；变更即时保存。"
                           IconSource="{ci:FluentIconSource &#xE9D9;}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="连接超时（秒）" VerticalAlignment="Center"/>
            <NumericUpDown Minimum="3" Maximum="120" Increment="1" Width="130"
                           Value="{Binding Settings.ConnectTimeoutSeconds, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="健康检查间隔（毫秒）" VerticalAlignment="Center"/>
            <NumericUpDown Minimum="1000" Maximum="60000" Increment="500" Width="150"
                           Value="{Binding Settings.HealthCheckIntervalMs, Mode=TwoWay}"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                     Text="此插件需要与独立 Duty-Agent 客户端配合使用：客户端会写入 meta 文件，插件据此获取端口和 token。"/>
        </StackPanel>
      </fa:SettingsExpander>

      <fa:SettingsExpander Header="路径诊断"
                           Description="meta 文件来源与日志目录。"
                           IconSource="{ci:FluentIconSource &#xE9D2;}">
        <StackPanel Spacing="4">
          <TextBlock x:Name="MetaSourceText" Text="" FontSize="12" Opacity="0.7"/>
          <TextBlock x:Name="MetaFileText" Text="" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
          <TextBlock x:Name="LogsDirectoryText" Text="" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="打开配置目录" Click="OnOpenConfigFolderClick"/>
            <Button Content="打开日志目录" Click="OnOpenLogsFolderClick"/>
          </StackPanel>
        </StackPanel>
      </fa:SettingsExpander>

      <fa:SettingsExpander Header="测试排班"
                           Description="向独立软件发送一条真实排班指令（由其配置的模型执行并写排班数据），需二次确认。"
                           IconSource="{ci:FluentIconSource &#xE945;}">
        <StackPanel Spacing="8">
          <Button x:Name="TestScheduleButton" Content="测试排班" Click="OnTestScheduleClick" HorizontalAlignment="Left"/>
          <TextBlock x:Name="TestResult" Text="" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
        </StackPanel>
      </fa:SettingsExpander>

      <fa:SettingsExpander Header="关于"
                           Description="与独立 Duty-Agent 客户端通信，提供 ClassIsland 通知和显示功能。"
                           IconSource="{ci:FluentIconSource &#xE946;}">
        <TextBlock x:Name="VersionText" Text="Duty-Agent Bridge" FontSize="12" Opacity="0.7"/>
      </fa:SettingsExpander>

    </StackPanel>
  </ScrollViewer>
</ci:SettingsPageBase>
