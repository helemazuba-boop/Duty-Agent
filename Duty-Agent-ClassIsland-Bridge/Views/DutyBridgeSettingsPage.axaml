<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                     x:Class="DutyAgentBridge.Views.DutyBridgeSettingsPage"
                     TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                     Background="{DynamicResource MaterialDesignPaper}"
                     FontFamily="{StaticResource HarmonyOsSans}"
                     TextElement.FontWeight="Regular"
                     TextElement.FontSize="14">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Text="Duty-Agent 桥接" FontSize="24" FontWeight="Bold"/>

      <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="连接状态" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusIndicator" Text="○ 未连接" FontSize="16"/>
          <TextBlock x:Name="ConnectionDetails" Text="" FontSize="12"
                     Opacity="0.7" IsVisible="False"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ReconnectButton" Content="重新连接" Click="OnReconnectClick" Width="110"/>
            <Button Content="打开状态目录" Click="OnOpenStandaloneClick" Width="130"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold"/>
          <ToggleSwitch Content="ClassIsland 启动后自动连接独立软件"
                        IsChecked="{Binding Settings.AutoConnect, Mode=TwoWay}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="连接超时（秒）" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="ConnectTimeoutInput" Minimum="3" Maximum="120" Increment="1"
                           Width="120" Value="{Binding Settings.ConnectTimeoutSeconds, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="健康检查间隔（毫秒）" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="HealthIntervalInput" Minimum="1000" Maximum="60000" Increment="500"
                           Width="140" Value="{Binding Settings.HealthCheckIntervalMs, Mode=TwoWay}"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                     Text="此插件需要与独立 Duty-Agent 客户端配合使用：客户端会写入 meta 文件，插件据此获取端口和 token。设置变更即时保存。"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Spacing="4">
          <TextBlock Text="路径诊断" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="MetaSourceText" Text="" FontSize="12" Opacity="0.7"/>
          <TextBlock x:Name="MetaFileText" Text="" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
          <TextBlock x:Name="LogsDirectoryText" Text="" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="打开配置目录" Click="OnOpenConfigFolderClick" Width="120"/>
            <Button Content="打开日志目录" Click="OnOpenLogsFolderClick" Width="120"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="测试" FontSize="14" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TestScheduleButton" Content="测试排班" Click="OnTestScheduleClick" Width="110"/>
          </StackPanel>
          <TextBlock x:Name="TestResult" Text="" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
          <TextBlock Text="将向独立软件发送一条真实排班指令（由其配置的模型执行并写排班数据）。" FontSize="12" Opacity="0.7"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Spacing="4">
          <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionText" Text="Duty-Agent Bridge" FontSize="12" Opacity="0.7"/>
          <TextBlock Text="与独立 Duty-Agent 客户端通信，提供 ClassIsland 通知和显示功能" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</ci:SettingsPageBase>
