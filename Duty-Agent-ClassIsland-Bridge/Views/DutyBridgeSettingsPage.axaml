<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DutyAgentBridge.Views.DutyBridgeSettingsPage">

  <ScrollViewer>
    <StackPanel Margin="24">
      <TextBlock Text="Duty-Agent 桥接设置" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>

      <Border Background="#f5f5f5" CornerRadius="8" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="连接状态" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="StatusIndicator" Text="○ 未连接" FontSize="16" Margin="0,0,0,4"/>
          <TextBlock x:Name="ConnectionDetails" Text="" FontSize="12" Foreground="#8c8c8c" IsVisible="False" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ReconnectButton" Content="重新连接" Click="OnReconnectClick" Width="100"/>
            <Button Content="打开状态目录" Click="OnOpenStandaloneClick" Width="120"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="#e6f7ff" BorderBrush="#91d5ff" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="提示" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666"
                     Text="此插件需要与独立 Duty-Agent 客户端配合使用。独立客户端会写入 meta 文件，插件根据该文件获取端口和 token。"/>
        </StackPanel>
      </Border>

      <Border Background="#fafafa" CornerRadius="8" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="路径诊断" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="ConfigSourceText" Text="" FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="ConfigFolderText" Text="" FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="MetaFileText" Text="" FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="LogsDirectoryText" Text="" FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock Text="候选路径" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="ConfigCandidatesText" Text="" FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="打开配置目录" Click="OnOpenConfigFolderClick" Width="120"/>
            <Button Content="打开日志目录" Click="OnOpenLogsFolderClick" Width="120"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="#fafafa" CornerRadius="8" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="测试区域" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="TestScheduleButton" Content="测试排班" Click="OnTestScheduleClick" Width="100"/>
          </StackPanel>
          <TextBlock x:Name="TestResult" Text="" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Background="#fafafa" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Duty-Agent Bridge v0.50.0" FontSize="12" Foreground="#8c8c8c"/>
          <TextBlock Text="与独立 Duty-Agent 客户端通信，提供 ClassIsland 通知和显示功能" FontSize="12" Foreground="#8c8c8c" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
