<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Windows Application Packaging Project（Desktop Bridge / MSIX）。

    这个工程只能用「带 Desktop Bridge 工作负载的 Visual Studio 自带的 MSBuild」构建，
    .NET SDK 的 MSBuild 不含 DesktopBridge 目标（本仓库其余 C# 项目仍用 dotnet build）。

    入口工程（..\DutyAgent.Client\DutyAgent.Client.csproj）自带 net8.0-windows
    TargetFramework / self-contained / win-x64，本工程只负责"发布 + 打包"，
    因此这里刻意不声明 TargetFramework，避免与 DesktopBridge 目标冲突。

    构建产物：DutyAgent.Client.Package\AppPackages\ 下的 .msix / .msixupload。
    前置条件、发布者 ID 替换、商店资产要求见同目录 README.md。
  -->
  <PropertyGroup>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Platform>x64</Platform>

    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(MSBuildProjectDirectory)\AppPackages\</AppxPackageDir>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <GenerateTemporaryStoreCertificate>true</GenerateTemporaryStoreCertificate>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>

    <!-- 提交商店前替换为 Partner Center 分配的发布者 ID（32 位十六进制，形如 CN=xxxx...）。 -->
    <AppxPackagePublisher>CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID</AppxPackagePublisher>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DutyAgent.Client\DutyAgent.Client.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <EntryPointProjectUniqueName>..\DutyAgent.Client\DutyAgent.Client.csproj</EntryPointProjectUniqueName>
  </PropertyGroup>

  <!--
    发布产物里的 Assets_Duty（含 85M 内嵌 Python）与桥接插件目录不在入口工程的
    输出路径里，需要显式随包。两处都是 build_msix 脚本先发布好、再用 $(PublishDir)
    交给本工程打包的。
  -->
  <ItemGroup>
    <Content Include="$(PublishDir)Assets_Duty\**">
      <Link>Assets_Duty\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PublishDir)bridge\**">
      <Link>bridge\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
